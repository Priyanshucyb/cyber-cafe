{
  "name": "local-cyber-cafe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node --import tsx scripts/prerender.tsx",
    "preview": "vite preview --host 0.0.0.0",
    "check:content": "node --import tsx scripts/check-content.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:release": "npm run check:content && npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
